# Copy this file to .env and fill in values. `.env` is gitignored — never commit it.

# Provider API keys — required ONLY for the plain-English → spec translation
# endpoint (/api/translate-strategy). The engine, audits, journal, and reports
# all work fully offline without any of them. Set whichever providers you want
# to use or benchmark; `make bench` skips models whose key is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults shown; see backend/config.py)
#
# Translation model — ANY key from the catalogue in backend/llm/pricing.py
# (Anthropic, OpenAI, or Gemini). Default: claude-sonnet-5.
#   HONEST_LLM_MODEL=gpt-5-nano
# Never pick on list price alone. Measure first:
#   make bench                     # accuracy + measured $/1k runs, side by side
#   make bench MODELS=gpt-5-nano,gemini-3.1-flash-lite,claude-sonnet-5
# A translator that silently reads "6-month" as 26 days is worthless at any
# price, so the bench gates on accuracy (>=90% spec, 100% clarify/refuse) and
# only uses cost to break ties.
# HONEST_LLM_MODEL=claude-sonnet-5      # Sonnet-class translation model
# HONEST_DB_PATH=data/honest.db         # SQLite database location
# HONEST_CACHE_DIR=data/price_cache     # parquet price cache
# HONEST_ACCOUNT_SIZE=10000             # assumed account size for capacity audit
